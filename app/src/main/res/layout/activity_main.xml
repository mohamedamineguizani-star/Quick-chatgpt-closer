<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick AI Closer"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triple-tap the top-right red badge to instantly force close Claude or ChatGPT, remove them from active apps (Recents), and wipe cloud chats."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- 1. Target App Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/primary"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Target App Detection"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select which app to force close and remove from the active apps list:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgTargetApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbTargetAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Auto-Detect (Claude or ChatGPT)"
                        android:textColor="@color/text_primary"
                        android:checked="true"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbTargetClaude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🟣 Claude (com.anthropic.claude)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbTargetChatGPT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🟢 ChatGPT (com.openai.chatgpt)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbTargetLastActive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 Any Last Active App"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Panic Cleaner Behavior Options -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Panic Closer Actions"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Remove from Active Apps (Recents) -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchRemoveFromRecents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Remove From Active App List (Recents)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opens Recents and flings the app card away so no active snapshot or card remains in the multitasker."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <!-- Deep Force Stop Option -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDeepForceStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deep System Force-Stop (Settings Automation)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opens App Details in Settings and automatically clicks 'Force stop' and confirms OK to kill all processes and alarms."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <!-- Wipe History Option -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWipeHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Purge Multiple Recent Chats (Top 5)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wipes multiple recent conversations from cloud history via API so no trace remains in sidebar."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Claude API / Session Token Card (OPTIONAL) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/claude"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Claude Account Token (Optional)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allows deleting Claude conversations directly on Anthropic servers upon panic."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOpenClaudePage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌐 Open Claude.ai in Browser"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste Claude sessionKey (sk-ant-sid01-...)"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxStrokeColor="@color/claude"
                    android:textColorHint="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/claudeTokenEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnSaveClaudeToken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Save Claude"
                        android:backgroundTint="@color/claude"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnTestClaudeConnection"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔌 Test Claude"
                        android:textColor="@color/claude"
                        app:strokeColor="@color/claude"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvClaudeConnectionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Claude Status: Not configured"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnTestDeleteClaudeChat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Test: Delete Last Claude Chat"
                    android:textColor="@color/claude"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. ChatGPT Account Token Card (OPTIONAL) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/primary"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. ChatGPT Account Token (Optional)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deletes chats directly on OpenAI servers without fragile screen-tapping."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOpenAuthPage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌐 Get Token from ChatGPT (Opens Browser)"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste accessToken (eyJhbGciOi...)"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxStrokeColor="@color/primary"
                    android:textColorHint="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tokenEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnSaveToken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Save ChatGPT"
                        android:backgroundTint="@color/primary"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnTestConnection"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔌 Test ChatGPT"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ChatGPT Status: Not tested"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnTestDeleteChat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Test: Delete Last ChatGPT Chat"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. System Permissions Overview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. System Permissions"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overlay: Checking..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOverlayPermission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Grant"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Accessibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility: Checking..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAccessibilityPermission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Enable"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Battery: Checking..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBatteryOptimization"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ignore"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Android 13/14/15 Restricted Setting Helper Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRestrictedSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#2D2214"
            app:strokeColor="#FF9800"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Switch Grayed Out? (Android 13 / 14 / 15 Fix)"
                    android:textColor="#FFB74D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If Accessibility says 'Restricted setting':\n1. Tap 'Unlock' below -> Tap 3 dots (⋮) top-right.\n2. Tap 'Allow restricted settings' and confirm PIN.\n3. Return and toggle Accessibility ON."
                    android:textColor="#FFE0B2"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnUnlockRestricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unlock Restricted Settings"
                    android:backgroundTint="#FF9800"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Start Guard Button -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Start Panic Closer Guard"
            android:backgroundTint="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- 7. Direct Panic Test -->
        <Button
            android:id="@+id/btnTestPanic"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ Test Panic Action (Close &amp; Clear Active App)"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
